# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============================================
# SITE CONFIGURATION (REQUIRED FOR SEO)
# ============================================

# Production URL - CRITICAL for SEO (sitemap, Open Graph, schema.org)
# Replace with your actual domain when deploying
# Example: https://cyprus-insights.com
NEXT_PUBLIC_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================

# MongoDB connection string
MONGODB_URI=your_mongodb_connection_string_here

# ============================================
# ADMIN AUTHENTICATION
# ============================================

# Admin session secret (generate a random string)
ADMIN_SESSION_SECRET=your_random_secret_here

# ============================================
# OPTIONAL - ANALYTICS & TRACKING
# ============================================

# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification
# NEXT_PUBLIC_GSC_VERIFICATION=your_verification_code

# ============================================
# OPTIONAL - EMAIL & NOTIFICATIONS
# ============================================

# Email service for lead notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ============================================
# SEO NOTES
# ============================================
# 
# NEXT_PUBLIC_URL is used for:
# - Sitemap generation (sitemap.xml)
# - Open Graph URLs
# - Schema.org structured data
# - Canonical URLs
# - Twitter Card URLs
#
# Make sure to update this before deploying to production!
